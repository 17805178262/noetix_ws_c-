# Select by target architecture, never by the host running CMake.
string(TOLOWER "${CMAKE_SYSTEM_PROCESSOR}" GMR_PROCESSOR)
if(GMR_PROCESSOR MATCHES "^(x86_64|amd64)$")
  set(GMR_ARCH x86_64)
  set(GMR_ELF_MACHINE "3e00")
elseif(GMR_PROCESSOR MATCHES "^(aarch64|arm64)$")
  set(GMR_ARCH aarch64)
  set(GMR_ELF_MACHINE "b700")
else()
  message(FATAL_ERROR "Unsupported target '${CMAKE_SYSTEM_PROCESSOR}'; supported: Linux x86_64 and ARM64/aarch64 (not 32-bit ARM)")
endif()
if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux")
  message(FATAL_ERROR "noetix_gmr requires Linux")
endif()
message(STATUS "noetix_gmr target architecture: ${GMR_ARCH}")

# Reading ELF headers works during cross compilation and requires no target execution.
function(gmr_library_matches path result)
  set(matches FALSE)
  if(EXISTS "${path}" AND NOT IS_DIRECTORY "${path}")
    file(SIZE "${path}" length)
    if(length GREATER_EQUAL 20)
      file(READ "${path}" header OFFSET 0 LIMIT 20 HEX)
      string(SUBSTRING "${header}" 0 12 ident)
      string(SUBSTRING "${header}" 36 4 machine)
      if(ident STREQUAL "7f454c460201" AND machine STREQUAL GMR_ELF_MACHINE)
        set(matches TRUE)
      endif()
    endif()
  endif()
  set(${result} ${matches} PARENT_SCOPE)
endfunction()

function(gmr_select_library root name result)
  # An explicit architecture directory wins; flat lib/ remains compatible with vendor SDK layouts.
  set(selected "${root}/lib/${name}")
  if(EXISTS "${root}/lib/${GMR_ARCH}/${name}")
    set(selected "${root}/lib/${GMR_ARCH}/${name}")
  endif()
  set(${result} "${selected}" PARENT_SCOPE)
endfunction()

function(gmr_require_library path label)
  gmr_library_matches("${path}" matches)
  if(NOT matches)
    message(FATAL_ERROR "${label}: missing or wrong ELF architecture for ${GMR_ARCH}: ${path}")
  endif()
endfunction()
